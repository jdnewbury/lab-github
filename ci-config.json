{
  "branchingModel": {
    "feature": "feature/*",
    "base": "main",
    "environments": [
      {
        "name": "Dev",
        "branch": "dev",
        "orgAlias": "dev",
        "orgType": "developer"
      },
      {
        "name": "Production",
        "branch": "main",
        "orgAlias": "SFDD",
        "orgType": "production"
      }
    ]
  },
  "deployOptions": {
    "checkOnlyOnFeature": true,
    "featureValidation": "scratch",
    "destructiveChanges": true,
    "sourceDir": "force-app"
  },
  "testOptions": {
    "runAllTests": true,
    "testLevel": "RunLocalTests",
    "gateAlias": "SFDD"
  }
}
